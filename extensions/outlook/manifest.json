{
  "manifest_version": 3,
  "name": "Outlook 加入 DeskTask",
  "version": "0.2.0",
  "description": "将当前 Outlook 网页邮件确认为本地 DeskTask 待办。",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*", "https://outlook.cloud.microsoft/*"],
    "js": ["extract.js", "content.js"],
    "run_at": "document_idle"
  }]
}
