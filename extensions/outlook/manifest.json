{
  "manifest_version": 3,
  "name": "邮件加入 DeskTask",
  "version": "0.3.0",
  "description": "将 Outlook、Gmail、QQ 和网易网页版邮件确认为本地日程。",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*", "https://outlook.cloud.microsoft/*", "https://mail.google.com/*", "https://mail.qq.com/*", "https://wx.mail.qq.com/*", "https://*.mail.163.com/*", "https://*.mail.126.com/*", "https://*.mail.yeah.net/*", "https://email.163.com/*"],
    "js": ["providers.js", "extract.js", "content.js"],
    "run_at": "document_idle"
  }]
}
